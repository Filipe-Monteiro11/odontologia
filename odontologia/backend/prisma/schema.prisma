
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Pacientes que realizam agendamentos
model Patient {
  id           Int           @id @default(autoincrement())
  name         String
  phone        String
  email        String?
  createdAt    DateTime      @default(now())
  appointments Appointment[]
}

// Serviços oferecidos pela dentista
model Service {
  id              Int           @id @default(autoincrement())
  name            String
  description     String?
  durationMinutes Int
  active          Boolean       @default(true)
  appointments    Appointment[]
}

// Agendamentos realizados pelos pacientes
model Appointment {
  id        Int      @id @default(autoincrement())
  patientId Int
  serviceId Int
  startAt   DateTime
  endAt     DateTime
  status    String   @default("confirmed")
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@index([startAt, endAt])
  @@index([patientId])
}

// Horários semanais de atendimento
model Availability {
  id        Int     @id @default(autoincrement())
  weekday   Int
  startTime String
  endTime   String
  active    Boolean @default(true)
}

// Bloqueios: feriados, férias e indisponibilidades
model BlockedSlot {
  id        Int      @id @default(autoincrement())
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())
}

// Administrador do sistema
model Admin {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
